{
  "name": "framecoach",
  "private": true,
  "version": "1.0.0",
  "description": "MusePilot — pose & composition guidance tool",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @framecoach/web",
